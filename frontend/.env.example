# Public build-time settings only. NEVER put service keys here.
# Use demo for the browser-only prototype, api for FastAPI persistence.
NEXT_PUBLIC_DATA_MODE=api
# Local development: use this relative URL with Vite's /api proxy.
# Production: relative path goes through the Vercel rewrite.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Vercel build setting: HTTPS origin of the deployed FastAPI backend.
BACKEND_URL=
