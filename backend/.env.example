# Development defaults. Copy to backend/.env and keep it out of Git.
APP_ENV=development
DEMO_ACCOUNTS_ENABLED=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Production: APP_ENV=production, COOKIE_SECURE=true,
# DEMO_ACCOUNTS_ENABLED=false, ALLOWED_ORIGINS=https://your-app.vercel.app
# Use the Vercel same-origin proxy so cookies stay first-party.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role JWT. SERVER ONLY.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=medora-documents

# SERVER ONLY. Model IDs can be changed without editing source.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Optional semantic document search. All settings below are required together.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=medora_documents
# Separate embedding provider: Groq chat is not an embedding service.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
SIGNED_URL_SECONDS=120
MAX_UPLOAD_BYTES=10485760
SESSION_SECONDS=3600
